{
  "name": "bsky-not-blocked",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox and Chromium extensions that restore Bluesky posts hidden from third-party viewers by a block between two other accounts.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "test:live": "BSKY_NOT_BLOCKED_LIVE=1 node --test 'test/*.test.mjs'",
    "test:e2e": "node scripts/build.mjs chrome && node test/e2e.mjs",
    "test:e2e:firefox": "node scripts/build.mjs firefox && node test/e2e-firefox.mjs",
    "lint:firefox": "node scripts/build.mjs firefox && web-ext lint --source-dir=dist/firefox --self-hosted",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "icons": "bash scripts/make-icons.sh"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "selenium-webdriver": "^4.47.0",
    "web-ext": "^10.6.0"
  }
}
